<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <RootNamespace>NotifyKit</RootNamespace>
        <AssemblyName>NotifyKit</AssemblyName>
        <PackageId>NotifyKit</PackageId>
        <Version>0.1.0</Version>
        <Description>Extensible notification library with channels, retry, scheduling and observers.</Description>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="src\Factories\" />
    </ItemGroup>
</Project>
